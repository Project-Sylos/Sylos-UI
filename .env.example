# Sylos UI - copy to .env.local and fill in, or place OAuth JSON in creds/
# See creds/README.txt

# API base (optional; defaults to http://localhost:8086)
# VITE_API_BASE=http://localhost:8086

# Google Drive OAuth (UI-owned; used for sign-in and token exchange)
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_SECRET=your-client-secret

# Dropbox OAuth (Full Dropbox app - not App folder)
# VITE_DROPBOX_CLIENT_ID=your-app-key
# VITE_DROPBOX_CLIENT_SECRET=your-app-secret
